+/// Build one agent-authored response using only the admitted channel and
+/// canonical thread from this turn. A top-level trigger becomes a new thread
+/// rooted at that trigger; a threaded trigger stays in its existing thread.
+fn build_auto_response_event(
+    keys: &nostr::Keys,
+    source: &PromptSource,
+    batch: Option<&FlushBatch>,
+    content: &str,
+) -> Option<nostr::Event> {
+    if content.trim().is_empty() || content.len() > 64 * 1024 {
+        return None;
+    }
+    let scope = source.scope()?;
+    let batch = batch?;
+    if scope != &batch.scope || batch.channel_id != scope.channel_id() {
+        return None;
+    }
+    let last_event = batch.events.last()?;
+    let routing_event_id = last_event.routing_event_id();
+    let thread_tags = last_event.routing_thread_tags();
+    let root = scope
+        .root_event_id()
+        .or(thread_tags.root_event_id.as_deref())
+        .unwrap_or(&routing_event_id);
+    let root_event_id = nostr::EventId::from_hex(root).ok()?;
+    let thread_ref = buzz_sdk::ThreadRef {
+        root_event_id,
+        // Replies stay flat under the trusted root; no model-selected parent
+        // can move them to another branch or channel.
+        parent_event_id: root_event_id,
+    };
+    let builder = buzz_sdk::build_message(
+        scope.channel_id(),
+        content,
+        Some(&thread_ref),
+        &[],
+        false,
+        &[],
+        &[],
+    )
+    .ok()?;
+    builder.sign_with_keys(keys).ok()
+}
+
+fn take_auto_response_event(
+    enabled: bool,
+    keys: &nostr::Keys,
+    source: &PromptSource,
+    batch: Option<&FlushBatch>,
+    stop_reason: &StopReason,
+    response_text: &mut Option<String>,
+) -> Option<nostr::Event> {
+    if !enabled || *stop_reason != StopReason::EndTurn {
+        response_text.take();
+        return None;
+    }
+    let content = response_text.take()?;
+    build_auto_response_event(keys, source, batch, &content)
+}
+
+/// Publish one completed ACP response only when the adapter explicitly opted
+/// in. Failed, cancelled, empty, oversized, heartbeat, and unrouteable turns
+/// are discarded without affecting prompt completion.
+async fn publish_auto_response(
+    enabled: bool,
+    rest: &RestClient,
+    source: &PromptSource,
+    batch: Option<&FlushBatch>,
+    stop_reason: &StopReason,
+    response_text: &mut Option<String>,
+) {
+    let Some(event) = take_auto_response_event(
+        enabled,
+        &rest.keys,
+        source,
+        batch,
+        stop_reason,
+        response_text,
+    ) else {
+        if enabled && *stop_reason == StopReason::EndTurn && response_text.is_none() {
+            tracing::warn!("completed hosted-agent response had no safe channel/thread route or publishable text");
+        }
+        return;
+    };
+    match tokio::time::timeout(Duration::from_secs(5), rest.submit_event(&event)).await {
+        Ok(Ok(_)) => {
+            tracing::info!(channel = %source.channel_id().unwrap_or_default(), "published hosted-agent response")
+        }
+        Ok(Err(error)) => tracing::warn!("hosted-agent response publication failed: {error}"),
+        Err(_) => tracing::warn!("hosted-agent response publication timed out"),
+    }
+}
