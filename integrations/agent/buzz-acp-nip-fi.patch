+/// Fetch a short-lived NIP-FI assertion for one relay authority.
+///
+/// The owner grant is only sent to the identity issuer. Relay requests receive
+/// the returned assertion in `Nostr-Federated-Identity`, alongside their
+/// ordinary route-specific NIP-98 proof.
+async fn fetch_fi_assertion(keys: &Keys, relay_url: &str) -> Result<Option<String>, RelayError> {
+    let endpoint = match std::env::var("BUZZ_FI_ASSERTION_URL") {
+        Ok(value) if !value.trim().is_empty() => value,
+        _ => {
+            if std::env::var_os("BUZZ_FI_GRANT_TOKEN").is_some() {
+                return Err(RelayError::Http(
+                    "BUZZ_FI_GRANT_TOKEN requires BUZZ_FI_ASSERTION_URL".into(),
+                ));
+            }
+            return Ok(None);
+        }
+    };
+    let grant = std::env::var("BUZZ_FI_GRANT_TOKEN").map_err(|_| {
+        RelayError::Http("BUZZ_FI_ASSERTION_URL requires BUZZ_FI_GRANT_TOKEN".into())
+    })?;
+    let parsed_endpoint = parse_fi_endpoint(&endpoint)?;
+
+    let body = serde_json::to_vec(&json!({
+        "agent_pubkey": keys.public_key().to_hex(),
+        "relay_url": relay_url,
+    }))
+    .map_err(|error| RelayError::Http(format!("FI assertion request encode error: {error}")))?;
+    use base64::Engine;
+    use sha2::{Digest, Sha256};
+    let tags = vec![
+        Tag::parse(["u", endpoint.as_str()])
+            .map_err(|error| RelayError::Http(format!("NIP-98 tag error: {error}")))?,
+        Tag::parse(["method", "POST"])
+            .map_err(|error| RelayError::Http(format!("NIP-98 tag error: {error}")))?,
+        Tag::parse(["nonce", &Uuid::new_v4().to_string()])
+            .map_err(|error| RelayError::Http(format!("NIP-98 tag error: {error}")))?,
+        Tag::parse(["payload", &hex::encode(Sha256::digest(&body))])
+            .map_err(|error| RelayError::Http(format!("NIP-98 tag error: {error}")))?,
+    ];
+    let proof = EventBuilder::new(Kind::HttpAuth, "")
+        .tags(tags)
+        .sign_with_keys(keys)
+        .map_err(|error| RelayError::Http(format!("NIP-98 sign error: {error}")))?;
+    let proof = base64::engine::general_purpose::STANDARD
+        .encode(serde_json::to_vec(&proof).map_err(|error| RelayError::Http(error.to_string()))?);
+    let response = fi_assertion_http_client()?
+        .post(parsed_endpoint)
+        .header("Authorization", format!("Bearer {grant}"))
+        .header("Nostr-Authorization", format!("Nostr {proof}"))
+        .header(reqwest::header::CONTENT_TYPE, "application/json")
+        .body(body)
+        .send()
+        .await
+        .map_err(|_| RelayError::Http("FI assertion request failed".into()))?;
+    validate_fi_status(response.status())?;
+    if response
+        .content_length()
+        .is_some_and(|length| length > FI_ASSERTION_MAX_BODY_BYTES as u64)
+    {
+        return Err(RelayError::Http(
+            "FI assertion response exceeds the size limit".into(),
+        ));
+    }
+    let mut response = response;
+    let mut body = Vec::with_capacity(
+        response
+            .content_length()
+            .unwrap_or_default()
+            .min(FI_ASSERTION_MAX_BODY_BYTES as u64) as usize,
+    );
+    while let Some(chunk) = response
+        .chunk()
+        .await
+        .map_err(|_| RelayError::Http("failed to read FI assertion response".into()))?
+    {
+        append_fi_body_chunk(&mut body, &chunk)?;
+    }
+    let assertion = validate_fi_assertion_response(
+        &body,
+        &keys.public_key().to_hex(),
+        chrono::Utc::now().timestamp(),
+    )?;
+    Ok(nip_fi_header(&assertion))
+}
+
+fn nip_fi_header(assertion: &str) -> Option<String> {
+    (!assertion.is_empty()).then(|| format!("Bearer {assertion}"))
+}
