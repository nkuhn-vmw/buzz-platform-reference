+const FI_ASSERTION_TIMEOUT: Duration = Duration::from_secs(10);
+const FI_ASSERTION_CONNECT_TIMEOUT: Duration = Duration::from_secs(5);
+const FI_ASSERTION_MAX_BODY_BYTES: usize = 16 * 1024;
+
+fn fi_assertion_http_client() -> Result<&'static reqwest::Client, RelayError> {
+    static CLIENT: OnceLock<Result<reqwest::Client, ()>> = OnceLock::new();
+    match CLIENT.get_or_init(|| {
+        reqwest::Client::builder()
+            .redirect(reqwest::redirect::Policy::none())
+            .connect_timeout(FI_ASSERTION_CONNECT_TIMEOUT)
+            .timeout(FI_ASSERTION_TIMEOUT)
+            .build()
+            .map_err(|_| ())
+    }) {
+        Ok(client) => Ok(client),
+        Err(()) => Err(RelayError::Http(
+            "could not initialize FI assertion HTTP client".into(),
+        )),
+    }
+}
+
+fn parse_fi_endpoint(endpoint: &str) -> Result<url::Url, RelayError> {
+    let parsed = endpoint
+        .parse::<url::Url>()
+        .map_err(|_| RelayError::Http("invalid BUZZ_FI_ASSERTION_URL".into()))?;
+    if parsed.scheme() != "https"
+        || parsed.host_str().is_none()
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.query().is_some()
+        || parsed.fragment().is_some()
+    {
+        return Err(RelayError::Http(
+            "BUZZ_FI_ASSERTION_URL must be an HTTPS URL without userinfo, query, or fragment"
+                .into(),
+        ));
+    }
+    Ok(parsed)
+}
+
+fn validate_fi_status(status: reqwest::StatusCode) -> Result<(), RelayError> {
+    if status == reqwest::StatusCode::OK {
+        Ok(())
+    } else {
+        Err(RelayError::Http(format!(
+            "FI assertion request returned HTTP {status}"
+        )))
+    }
+}
+
+fn append_fi_body_chunk(body: &mut Vec<u8>, chunk: &[u8]) -> Result<(), RelayError> {
+    if body.len().saturating_add(chunk.len()) > FI_ASSERTION_MAX_BODY_BYTES {
+        return Err(RelayError::Http(
+            "FI assertion response exceeds the size limit".into(),
+        ));
+    }
+    body.extend_from_slice(chunk);
+    Ok(())
+}
+
+fn validate_fi_assertion_response(
+    body: &[u8],
+    expected_pubkey: &str,
+    now: i64,
+) -> Result<String, RelayError> {
+    #[derive(serde::Deserialize)]
+    struct AssertionResponse {
+        assertion: String,
+        nostr_pubkey: String,
+        expires_at: i64,
+    }
+
+    let response: AssertionResponse = serde_json::from_slice(body)
+        .map_err(|_| RelayError::Http("invalid FI assertion response".into()))?;
+    if response.nostr_pubkey != expected_pubkey {
+        return Err(RelayError::Http(
+            "FI assertion response key does not match the agent".into(),
+        ));
+    }
+    if response.assertion.is_empty()
+        || response.expires_at <= now
+        || response.expires_at.saturating_sub(now) > 300
+    {
+        return Err(RelayError::Http(
+            "FI assertion response has invalid expiry or assertion".into(),
+        ));
+    }
+
+    use base64::Engine;
+    let mut parts = response.assertion.split('.');
+    let (Some(header), Some(claims), Some(signature), None) =
+        (parts.next(), parts.next(), parts.next(), parts.next())
+    else {
+        return Err(RelayError::Http("FI assertion is not a compact JWT".into()));
+    };
+    if signature.is_empty() {
+        return Err(RelayError::Http("FI assertion JWT has no signature".into()));
+    }
+    let decode_json = |part: &str| -> Result<Value, RelayError> {
+        let bytes = base64::engine::general_purpose::URL_SAFE_NO_PAD
+            .decode(part)
+            .map_err(|_| RelayError::Http("FI assertion JWT is malformed".into()))?;
+        serde_json::from_slice(&bytes)
+            .map_err(|_| RelayError::Http("FI assertion JWT is malformed".into()))
+    };
+    let header = decode_json(header)?;
+    let claims = decode_json(claims)?;
+    let issued_at = claims.get("iat").and_then(Value::as_i64);
+    let expires_at = claims.get("exp").and_then(Value::as_i64);
+    if !matches!(
+        header.get("alg").and_then(Value::as_str),
+        Some("ES256" | "RS256")
+    ) || header.get("typ").and_then(Value::as_str) != Some("nip-fi-agent+jwt")
+        || claims.get("nostr_pubkey").and_then(Value::as_str) != Some(expected_pubkey)
+        || expires_at != Some(response.expires_at)
+        || issued_at.is_none_or(|iat| iat > now.saturating_add(5))
+        || issued_at
+            .zip(expires_at)
+            .is_none_or(|(iat, exp)| exp <= iat || exp.saturating_sub(iat) > 300)
+    {
+        return Err(RelayError::Http(
+            "FI assertion JWT failed type, key, or expiry checks".into(),
+        ));
+    }
+    Ok(response.assertion)
+}
