+pub(crate) fn relay_ws_url_from_http(http_url: &str) -> Option<String> {
+    let mut parsed = url::Url::parse(http_url).ok()?;
+    if !parsed.username().is_empty() || parsed.password().is_some() {
+        return None;
+    }
+    let relay_scheme = match parsed.scheme() {
+        "https" => "wss",
+        "http" => "ws",
+        _ => return None,
+    };
+    parsed.set_scheme(relay_scheme).ok()?;
+    Some(parsed.origin().ascii_serialization())
+}
+
+pub(crate) async fn nip_fi_header_for_keys(
+    state: &AppState,
+    http_url: &str,
+    keys: &Keys,
+) -> Result<Option<String>, String> {
+    if relay_ws_url_from_http(http_url).as_deref() == Some(crate::nip_fa::PLATFORM_RELAY) {
+        crate::nip_fa::assertion_for_keys(state, crate::nip_fa::PLATFORM_RELAY, keys)
+            .await
+            .map(Some)
+    } else {
+        Ok(None)
+    }
+}
