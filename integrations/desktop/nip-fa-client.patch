+//! Native NIP-FA login and assertion client for this deployment.
+//!
+//! Adapter session credentials stay in the OS keyring. NIP-FI assertions are
+//! short lived and are fetched for the exact relay/key immediately before use.
+
+use std::{
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc, OnceLock,
+    },
+    time::Duration,
+};
+
+use axum::{
+    extract::{Query, State as AxumState},
+    http::StatusCode,
+    response::IntoResponse,
+    routing::get,
+    Router,
+};
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use tauri::ipc::Channel;
+use tokio::{net::TcpListener, sync::oneshot};
+use tokio_util::sync::CancellationToken;
+use url::Url;
+
+pub const IDENTITY_ORIGIN: &str = match option_env!("BUZZ_IDENTITY_ORIGIN") {
+    Some(value) => value,
+    None => "https://identity.example.invalid",
+};
+pub const PLATFORM_RELAY: &str = match option_env!("BUZZ_RELAY_URL") {
+    Some(value) => value,
+    None => "wss://relay.example.invalid",
+};
+pub const RELAY_HTTP_ORIGIN: &str = match option_env!("BUZZ_RELAY_HTTP_ORIGIN") {
+    Some(value) => value,
+    None => "https://relay.example.invalid",
+};
+const KEYRING_ITEM: &str = concat!("nip-fa-session:", env!("BUZZ_DESKTOP_PROFILE"));
+const LOGIN_TIMEOUT: Duration = Duration::from_secs(600);
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(20);
+const KEYRING_IO_TIMEOUT: Duration = Duration::from_secs(5);
+static NEXT_LOGIN_ID: AtomicU64 = AtomicU64::new(1);
+
+fn session_store_lock() -> &'static Arc<tokio::sync::Mutex<()>> {
+    static LOCK: OnceLock<Arc<tokio::sync::Mutex<()>>> = OnceLock::new();
+    LOCK.get_or_init(|| Arc::new(tokio::sync::Mutex::new(())))
+}
+
+#[derive(Default)]
+struct AuthFlowState {
+    active_login: Option<(u64, CancellationToken)>,
+    logout_in_progress: bool,
+}
+
+fn auth_flow_state() -> &'static tokio::sync::Mutex<AuthFlowState> {
+    static STATE: OnceLock<tokio::sync::Mutex<AuthFlowState>> = OnceLock::new();
+    STATE.get_or_init(|| tokio::sync::Mutex::new(AuthFlowState::default()))
+}
+
+struct AbortOnDrop(tokio::task::JoinHandle<()>);
+impl Drop for AbortOnDrop {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+struct StoredSession {
+    token: String,
+}
+
+#[derive(Debug, Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum LogoutOutcome {
+    GrantsRevoked,
+    SessionAlreadyInvalid,
+    NoLocalSession,
+}
+
+#[derive(Debug)]
+enum SessionCheckError {
+    Expired,
+    Other(String),
+}
+impl std::fmt::Display for SessionCheckError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Expired => f.write_str("identity session expired; sign in again"),
+            Self::Other(error) => f.write_str(error),
+        }
+    }
+}
+impl std::fmt::Debug for StoredSession {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("StoredSession([REDACTED])")
+    }
+}
+
+#[derive(Debug, Deserialize)]
+struct LoginExchange {
+    session_token: String,
+    expires_at: String,
+}
+#[derive(Debug, Deserialize)]
+struct SessionCheck {
+    expires_at: String,
+    email: Option<String>,
+}
+#[derive(Deserialize)]
+struct AssertionResponse {
+    assertion: String,
+    nostr_pubkey: String,
+    expires_at: i64,
+}
+#[derive(Deserialize)]
+struct AdapterErrorBody {
+    error: Option<String>,
+}
+#[derive(Debug, Deserialize)]
+struct CallbackQuery {
+    code: Option<String>,
+    error: Option<String>,
+    state: Option<String>,
+}
+
+struct CallbackState {
+    expected_state: String,
+    sender: Option<oneshot::Sender<Result<String, String>>>,
+}
+
+fn secret_store() -> &'static crate::secret_store::SecretStore {
+    crate::secret_store::SecretStore::shared(crate::app_state::keyring_service())
+}
+
+async fn load_session() -> Result<Option<StoredSession>, String> {
+    run_session_store_io(session_store_lock().clone(), KEYRING_IO_TIMEOUT, || {
+        secret_store()
+            .load_all_readonly()?
+            .and_then(|entries| entries.get(KEYRING_ITEM).cloned())
+            .map(|s| {
+                serde_json::from_str(&s).map_err(|_| "stored NIP-FA session is corrupt".to_owned())
+            })
+            .transpose()
+    })
+    .await
+}
+
+async fn save_session(session: StoredSession, cancel: CancellationToken) -> Result<(), String> {
+    run_session_store_io(
+        session_store_lock().clone(),
+        KEYRING_IO_TIMEOUT,
+        move || {
+            if cancel.is_cancelled() {
+                return Err("Platform sign-in cancelled".to_owned());
+            }
+            let value = serde_json::to_string(&session)
+                .map_err(|_| "could not encode NIP-FA session".to_owned())?;
+            let store = secret_store();
+            store.store(KEYRING_ITEM, &value)?;
+            if cancel.is_cancelled() {
+                store.delete(KEYRING_ITEM)?;
+                return Err("Platform sign-in cancelled".to_owned());
+            }
+            Ok(())
+        },
+    )
+    .await
+}
+
+async fn clear_session() -> Result<(), String> {
+    run_session_store_io(session_store_lock().clone(), KEYRING_IO_TIMEOUT, || {
+        secret_store().delete(KEYRING_ITEM)
+    })
+    .await
+}
+
+async fn run_session_store_io<T, F>(
+    lock: Arc<tokio::sync::Mutex<()>>,
+    timeout: Duration,
+    operation: F,
+) -> Result<T, String>
+where
+    T: Send + 'static,
+    F: FnOnce() -> Result<T, String> + Send + 'static,
+{
+    let deadline = tokio::time::Instant::now() + timeout;
+    let guard = tokio::time::timeout_at(deadline, lock.lock_owned())
+        .await
+        .map_err(|_| keyring_timeout_error(timeout))?;
+    let (sender, receiver) = tokio::sync::oneshot::channel();
+    tokio::spawn(async move {
+        let _guard = guard;
+        let result = tokio::task::spawn_blocking(operation)
+            .await
+            .map_err(|error| format!("secure credential storage task failed: {error}"))
+            .and_then(|result| result);
+        let _ = sender.send(result);
+    });
+    match tokio::time::timeout_at(deadline, receiver).await {
+        Ok(Ok(result)) => result,
+        Ok(Err(_)) => Err("secure credential storage task stopped".to_owned()),
+        Err(_) => Err(keyring_timeout_error(timeout)),
+    }
+}
+
+fn keyring_timeout_error(timeout: Duration) -> String {
+    format!(
+        "OS credential storage did not respond within {} seconds; check for a macOS keychain approval prompt or unlock the login keychain, then retry",
+        timeout.as_secs_f64()
+    )
+}
+
+fn handoff_challenge(secret: &str) -> String {
+    URL_SAFE_NO_PAD.encode(Sha256::digest(secret.as_bytes()))
+}
+
+async fn callback(
+    Query(query): Query<CallbackQuery>,
+    AxumState(state): AxumState<std::sync::Arc<tokio::sync::Mutex<CallbackState>>>,
+) -> impl IntoResponse {
+    let mut state = state.lock().await;
+    if query.state.as_deref() != Some(state.expected_state.as_str()) {
+        return (
+            StatusCode::BAD_REQUEST,
+            "Buzz ignored an invalid sign-in callback. Return to the desktop app.",
+        );
+    }
+    let was_refused = query.error.is_some();
+    let result = match (query.code, query.error) {
+        (Some(code), None) if !code.is_empty() => Ok(code),
+        (_, Some(_)) => Err("identity provider login was refused".to_owned()),
+        _ => Err("identity provider returned an invalid callback".to_owned()),
+    };
+    if let Some(sender) = state.sender.take() {
+        let _ = sender.send(result);
+    }
+    if was_refused {
+        (
+            StatusCode::UNAUTHORIZED,
+            "Platform sign-in was refused. You can return to the desktop app.",
+        )
+    } else {
+        (
+            StatusCode::OK,
+            "Buzz sign-in complete. You can return to the desktop app.",
+        )
+    }
+}
+
+/// Run the NIP-FA loopback handoff, exchange, and mandatory fixed-session check.
+pub async fn login(on_handoff_url: Channel<String>) -> Result<String, String> {
+    let login_id = NEXT_LOGIN_ID.fetch_add(1, Ordering::Relaxed);
+    let cancel = CancellationToken::new();
+    {
+        let mut state = auth_flow_state().lock().await;
+        if state.logout_in_progress {
+            return Err("Platform sign-out is in progress; retry sign-in when it finishes".to_owned());
+        }
+        if let Some((_, previous)) = state.active_login.replace((login_id, cancel.clone())) {
+            previous.cancel();
+        }
+    }
+    let result = tokio::select! {
+        _ = cancel.cancelled() => Err("Platform sign-in cancelled".to_owned()),
+        result = login_flow(on_handoff_url, cancel.clone()) => result,
+    };
+    finish_login(login_id).await;
+    result
+}
+
+async fn login_flow(
+    on_handoff_url: Channel<String>,
+    cancel: CancellationToken,
+) -> Result<String, String> {
+    if let Some(session) = load_session().await? {
+        let client = identity_client()?;
+        match check_session(&client, &session.token).await {
+            Ok(check) => return Ok(check.email.unwrap_or_else(|| "Platform account".to_owned())),
+            Err(SessionCheckError::Expired) => {}
+            Err(error) => return Err(error.to_string()),
+        }
+    }
+    login_with_browser(on_handoff_url, cancel).await
+}
+
+fn identity_client() -> Result<reqwest::Client, String> {
+    reqwest::Client::builder()
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .map_err(|e| e.to_string())
+}
+
+async fn finish_login(login_id: u64) {
+    let mut state = auth_flow_state().lock().await;
+    if state
+        .active_login
+        .as_ref()
+        .is_some_and(|(active_id, _)| *active_id == login_id)
+    {
+        state.active_login = None;
+    }
+}
+
+async fn cancel_pending_login() -> bool {
+    if let Some((_, token)) = auth_flow_state().lock().await.active_login.take() {
+        token.cancel();
+        true
+    } else {
+        false
+    }
+}
+
+async fn login_with_browser(
+    on_handoff_url: Channel<String>,
+    cancel: CancellationToken,
+) -> Result<String, String> {
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .map_err(|e| format!("could not bind sign-in callback: {e}"))?;
+    let port = listener.local_addr().map_err(|e| e.to_string())?.port();
+    let mut callback_url =
+        Url::parse(&format!("http://127.0.0.1:{port}/callback")).map_err(|e| e.to_string())?;
+    let mut state_bytes = [0u8; 32];
+    getrandom::getrandom(&mut state_bytes)
+        .map_err(|_| "secure random source unavailable".to_owned())?;
+    let state = URL_SAFE_NO_PAD.encode(state_bytes);
+    callback_url.query_pairs_mut().append_pair("state", &state);
+    // Generate a high entropy handoff secret and derive the S256 challenge.
+    let mut secret = [0u8; 32];
+    getrandom::getrandom(&mut secret).map_err(|_| "secure random source unavailable".to_owned())?;
+    let handoff = URL_SAFE_NO_PAD.encode(secret);
+    let challenge = handoff_challenge(&handoff);
+    let mut start =
+        Url::parse(&format!("{IDENTITY_ORIGIN}/v1/login/start")).map_err(|e| e.to_string())?;
+    start
+        .query_pairs_mut()
+        .append_pair("return_to", callback_url.as_str())
+        .append_pair("handoff_challenge", &challenge)
+        .append_pair("handoff_challenge_method", "S256");
+    let (sender, receiver) = oneshot::channel();
+    let router = Router::new()
+        .route("/callback", get(callback))
+        .with_state(std::sync::Arc::new(tokio::sync::Mutex::new(
+            CallbackState {
+                expected_state: state,
+                sender: Some(sender),
+            },
+        )));
+    let server = tokio::spawn(async move {
+        let _ = axum::serve(listener, router).await;
+    });
+    let _server_guard = AbortOnDrop(server);
+    on_handoff_url
+        .send(start.as_str().to_owned())
+        .map_err(|_| "sign-in link could not be delivered to the desktop".to_owned())?;
+    if std::env::var_os("BUZZ_NIP_FA_LOG_HANDOFF_URL").is_some() {
+        eprintln!("buzz-desktop: NIP-FA short-lived handoff URL: {start}");
+    }
+    let result = async {
+        let code = tokio::time::timeout(LOGIN_TIMEOUT, receiver)
+            .await
+            .map_err(|_| "identity login timed out".to_owned())?
+            .map_err(|_| "identity login callback stopped".to_owned())??;
+        let client = identity_client()?;
+        let response = client
+            .post(format!("{IDENTITY_ORIGIN}/v1/login/exchange"))
+            .json(&serde_json::json!({"code":code,"handoff_secret":handoff}))
+            .timeout(REQUEST_TIMEOUT)
+            .send()
+            .await
+            .map_err(|e| format!("identity code exchange failed: {e}"))?;
+        if response.status().is_redirection() {
+            return Err("identity code exchange refused a redirect".to_owned());
+        }
+        if !response.status().is_success() {
+            return Err(format!(
+                "identity code exchange returned HTTP {}",
+                response.status()
+            ));
+        }
+        let exchanged: LoginExchange = response
+            .json()
+            .await
+            .map_err(|_| "invalid identity code exchange response".to_owned())?;
+        if exchanged.session_token.is_empty() {
+            return Err("identity adapter returned an empty session".to_owned());
+        }
+        let check = check_session(&client, &exchanged.session_token)
+            .await
+            .map_err(|error| error.to_string())?;
+        let a = chrono::DateTime::parse_from_rfc3339(&exchanged.expires_at)
+            .map_err(|_| "invalid exchange expiry".to_owned())?;
+        let b = chrono::DateTime::parse_from_rfc3339(&check.expires_at)
+            .map_err(|_| "invalid session expiry".to_owned())?;
+        if a != b {
+            return Err("identity session expiry changed during verification".to_owned());
+        }
+        save_session(
+            StoredSession {
+                token: exchanged.session_token,
+            },
+            cancel.clone(),
+        )
+        .await?;
+        Ok(check.email.unwrap_or_else(|| "Platform account".to_owned()))
+    };
+    result.await
+}
+
+#[tauri::command]
+pub async fn nip_fa_login(on_handoff_url: Channel<String>) -> Result<String, String> {
+    login(on_handoff_url).await
+}
+
+#[tauri::command]
+pub async fn nip_fa_cancel_login() -> bool {
+    cancel_pending_login().await
+}
+
+#[tauri::command]
+pub async fn nip_fa_logout() -> Result<LogoutOutcome, String> {
+    {
+        let mut state = auth_flow_state().lock().await;
+        state.logout_in_progress = true;
+        if let Some((_, token)) = state.active_login.take() {
+            token.cancel();
+        }
+    }
+    let result = logout_flow().await;
+    auth_flow_state().lock().await.logout_in_progress = false;
+    result
+}
+
+async fn logout_flow() -> Result<LogoutOutcome, String> {
+    let Some(session) = load_session().await? else {
+        return Ok(LogoutOutcome::NoLocalSession);
+    };
+    let client = identity_client()?;
+    let response = client
+        .post(format!("{IDENTITY_ORIGIN}/v1/logout"))
+        .bearer_auth(&session.token)
+        .timeout(REQUEST_TIMEOUT)
+        .send()
+        .await
+        .map_err(|e| format!("identity logout failed: {e}"))?;
+    if response.status().is_redirection() {
+        return Err("identity logout refused a redirect".to_owned());
+    }
+    if response.status().is_success() {
+        clear_session().await?;
+        return Ok(LogoutOutcome::GrantsRevoked);
+    }
+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {
+        clear_session().await?;
+        return Ok(LogoutOutcome::SessionAlreadyInvalid);
+    }
+    Err(format!(
+        "identity logout returned HTTP {}",
+        response.status()
+    ))
+}
+
+async fn check_session(
+    client: &reqwest::Client,
+    token: &str,
+) -> Result<SessionCheck, SessionCheckError> {
+    let mut last_error = None;
+    let mut accepted = None;
+    for attempt in 0..3 {
+        match client
+            .get(format!("{IDENTITY_ORIGIN}/v1/session"))
+            .bearer_auth(token)
+            .timeout(REQUEST_TIMEOUT)
+            .send()
+            .await
+        {
+            Ok(response)
+                if response.status() == reqwest::StatusCode::TOO_MANY_REQUESTS
+                    || response.status().is_server_error() =>
+            {
+                let delay = retry_delay(
+                    attempt,
+                    response.headers().get(reqwest::header::RETRY_AFTER),
+                );
+                last_error = Some(format!(
+                    "identity session check returned HTTP {}",
+                    response.status()
+                ));
+                if attempt < 2 {
+                    tokio::time::sleep(delay).await;
+                    continue;
+                }
+                accepted = Some(response);
+            }
+            Ok(response) => accepted = Some(response),
+            Err(error) => {
+                last_error = Some(format!("identity session check failed: {error}"));
+                if attempt < 2 {
+                    tokio::time::sleep(retry_delay(attempt, None)).await;
+                    continue;
+                }
+            }
+        }
+        break;
+    }
+    let response = accepted.ok_or_else(|| {
+        SessionCheckError::Other(
+            last_error.unwrap_or_else(|| "identity session check failed".to_owned()),
+        )
+    })?;
+    if response.status().is_redirection() {
+        return Err(SessionCheckError::Other(
+            "identity session check refused a redirect".to_owned(),
+        ));
+    }
+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {
+        clear_session().await.map_err(SessionCheckError::Other)?;
+        return Err(SessionCheckError::Expired);
+    }
+    if !response.status().is_success() {
+        return Err(SessionCheckError::Other(format!(
+            "identity session check returned HTTP {}",
+            response.status()
+        )));
+    }
+    response
+        .json()
+        .await
+        .map_err(|_| SessionCheckError::Other("invalid identity session response".to_owned()))
+}
+
+fn retry_delay(attempt: u32, retry_after: Option<&reqwest::header::HeaderValue>) -> Duration {
+    let suggested = retry_after
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| {
+            value.parse::<u64>().ok().or_else(|| {
+                chrono::DateTime::parse_from_rfc2822(value)
+                    .ok()
+                    .map(|retry_at| {
+                        (retry_at.timestamp() - chrono::Utc::now().timestamp()).max(0) as u64
+                    })
+            })
+        });
+    Duration::from_millis(
+        suggested
+            .map(|seconds| seconds.saturating_mul(1000).min(1000))
+            .unwrap_or(150 + attempt as u64 * 200),
+    )
+}
+
+/// Mint a NIP-FA assertion bound to the exact key and canonical relay URL.
+pub async fn assertion(
+    state: &crate::app_state::AppState,
+    relay_url: &str,
+) -> Result<String, String> {
+    let keys = state.signing_keys()?;
+    assertion_for_keys(state, relay_url, &keys).await
+}
+
+pub async fn assertion_for_http_base(
+    state: &crate::app_state::AppState,
+    http_base: &str,
+) -> Result<Option<String>, String> {
+    if http_base.trim_end_matches('/') != RELAY_HTTP_ORIGIN {
+        return Ok(None);
+    }
+    assertion(state, PLATFORM_RELAY).await.map(Some)
+}
+
+pub async fn assertion_for_keys(
+    state: &crate::app_state::AppState,
+    relay_url: &str,
+    keys: &nostr::Keys,
+) -> Result<String, String> {
+    if relay_url != PLATFORM_RELAY {
+        return Err("NIP-FA is configured only for the platform deployment relay".to_owned());
+    }
+    if state.signing_keys()?.public_key() != keys.public_key() {
+        return Err("agent-key NIP-FI grants are not enabled in this desktop deployment".to_owned());
+    }
+    let session = load_session().await?.ok_or_else(|| {
+        "sign in to platform in Settings → Profile → platform sign-in before connecting".to_owned()
+    })?;
+    let client = identity_client()?;
+    check_session(&client, &session.token)
+        .await
+        .map_err(|error| error.to_string())?;
+    let pubkey = keys.public_key().to_hex();
+    let endpoint = format!("{IDENTITY_ORIGIN}/v1/identity/assertions");
+    let body =
+        serde_json::to_vec(&serde_json::json!({"relay_url":relay_url,"nostr_pubkey":pubkey}))
+            .map_err(|e| e.to_string())?;
+    let response = {
+        let mut last_error = None;
+        let mut accepted = None;
+        for attempt in 0..3 {
+            let proof = crate::relay::build_nip98_auth_header_for_keys(
+                keys,
+                &reqwest::Method::POST,
+                &endpoint,
+                &body,
+            )?;
+            let request = client
+                .post(&endpoint)
+                .bearer_auth(&session.token)
+                .header("Nostr-Authorization", proof)
+                .header("Content-Type", "application/json")
+                .body(body.clone())
+                .timeout(REQUEST_TIMEOUT);
+            match request.send().await {
+                Ok(response)
+                    if response.status() == reqwest::StatusCode::TOO_MANY_REQUESTS
+                        || response.status().is_server_error() =>
+                {
+                    let delay = retry_delay(
+                        attempt,
+                        response.headers().get(reqwest::header::RETRY_AFTER),
+                    );
+                    last_error = Some(format!(
+                        "identity assertion request returned HTTP {}",
+                        response.status()
+                    ));
+                    if attempt < 2 {
+                        tokio::time::sleep(delay).await;
+                        continue;
+                    }
+                    accepted = Some(response);
+                }
+                Ok(response) => accepted = Some(response),
+                Err(error) => {
+                    last_error = Some(format!("identity assertion request failed: {error}"));
+                    if attempt < 2 {
+                        tokio::time::sleep(retry_delay(attempt, None)).await;
+                        continue;
+                    }
+                }
+            }
+            break;
+        }
+        accepted.ok_or_else(|| {
+            last_error.unwrap_or_else(|| "identity assertion request failed".to_owned())
+        })?
+    };
+    if response.status().is_redirection() {
+        return Err("identity assertion request refused a redirect".to_owned());
+    }
+    if response.status() == reqwest::StatusCode::UNAUTHORIZED {
+        clear_session().await?;
+        return Err("identity session expired; sign in again".to_owned());
+    }
+    if response.status() == reqwest::StatusCode::FORBIDDEN {
+        let code = response
+            .json::<AdapterErrorBody>()
+            .await
+            .ok()
+            .and_then(|body| body.error);
+        return Err(match code.as_deref() {
+            Some("binding_mismatch") => "This platform Google account does not own the Buzz key. Sign out in Settings → Profile → platform sign-in, then sign in with the enrolled account.".to_owned(),
+            Some("authorization_denied") => "Platform refused this identity assertion; check that this account is approved for the deployment.".to_owned(),
+            _ => "Platform refused this identity assertion; check platform deployment access.".to_owned(),
+        });
+    }
+    if !response.status().is_success() {
+        return Err(format!(
+            "identity assertion request returned HTTP {}",
+            response.status()
+        ));
+    }
+    let answer: AssertionResponse = response
+        .json()
+        .await
+        .map_err(|_| "identity assertion response was malformed".to_owned())?;
+    let now = chrono::Utc::now().timestamp();
+    if answer.nostr_pubkey != pubkey
+        || answer.assertion.is_empty()
+        || answer.expires_at <= now
+        || answer.expires_at - now > 300
+        || !valid_assertion(&answer.assertion, answer.expires_at)
+    {
+        return Err("identity assertion response failed key or expiry checks".to_owned());
+    }
+    Ok(answer.assertion)
+}
+
+fn valid_assertion(token: &str, response_exp: i64) -> bool {
+    let mut parts = token.split('.');
+    let (Some(header), Some(claims), Some(signature), None) =
+        (parts.next(), parts.next(), parts.next(), parts.next())
+    else {
+        return false;
+    };
+    if header.is_empty() || signature.is_empty() {
+        return false;
+    }
+    let Ok(header) = URL_SAFE_NO_PAD.decode(header) else {
+        return false;
+    };
+    let Ok(header) = serde_json::from_slice::<serde_json::Value>(&header) else {
+        return false;
+    };
+    let Ok(claims) = URL_SAFE_NO_PAD.decode(claims) else {
+        return false;
+    };
+    let Ok(claims) = serde_json::from_slice::<serde_json::Value>(&claims) else {
+        return false;
+    };
+    let Some(exp) = claims.get("exp").and_then(|v| v.as_i64()) else {
+        return false;
+    };
+    let Some(iat) = claims.get("iat").and_then(|v| v.as_i64()) else {
+        return false;
+    };
+    header.get("typ").and_then(|v| v.as_str()) == Some("nip-fi+jwt")
+        && exp == response_exp
+        && exp > iat
+        && exp - iat <= 300
+}
