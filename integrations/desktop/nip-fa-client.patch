--- /dev/null
+++ b/desktop/src/features/settings/ui/PlatformSignInSection.tsx
@@ -0,0 +1,158 @@
+import { isTauri } from "@tauri-apps/api/core";
+import { Copy } from "lucide-react";
+import * as React from "react";
+import { toast } from "sonner";
+
+import {
+  cancelPlatformSignIn,
+  signInToPlatform,
+  signOutOfPlatform,
+} from "@/shared/api/tauriIdentity";
+import { writeTextToClipboard } from "@/shared/lib/clipboard";
+import { Button } from "@/shared/ui/button";
+import { Input } from "@/shared/ui/input";
+import { Spinner } from "@/shared/ui/spinner";
+import { SettingsOptionGroup, SettingsOptionRow } from "./SettingsOptionGroup";
+
+export function PlatformSignInSection() {
+  const [busy, setBusy] = React.useState(false);
+  const [handoffUrl, setHandoffUrl] = React.useState<string | null>(null);
+  const [status, setStatus] = React.useState<string | null>(null);
+
+  React.useEffect(
+    () => () => {
+      void cancelPlatformSignIn().catch(() => {});
+    },
+    [],
+  );
+
+  if (!isTauri()) return null;
+
+  const signIn = async () => {
+    setBusy(true);
+    setHandoffUrl(null);
+    setStatus("Waiting for platform sign-in…");
+    try {
+      const email = await signInToPlatform(setHandoffUrl);
+      setHandoffUrl(null);
+      setStatus(`Signed in to platform as ${email}.`);
+      toast.success(`Signed in to platform as ${email}`);
+    } catch (error) {
+      const message =
+        error instanceof Error ? error.message : "platform sign-in failed";
+      setStatus(message);
+      toast.error(message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const signOut = async () => {
+    setBusy(true);
+    setHandoffUrl(null);
+    try {
+      const outcome = await signOutOfPlatform();
+      const message =
+        outcome === "grants_revoked"
+          ? "Signed out of platform and revoked this account’s owned agent grants. Your Buzz key and local data are unchanged."
+          : outcome === "session_already_invalid"
+            ? "The platform session was already expired or revoked. The local session was cleared; this sign-out did not revoke additional grants."
+            : "No local platform session was present, so no grant revocation was attempted.";
+      setStatus(message);
+      toast.success(message);
+    } catch (error) {
+      const message =
+        error instanceof Error ? error.message : "platform sign-out failed";
+      setStatus(`platform sign-out could not be completed. ${message}`);
+      toast.error(message);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <SettingsOptionGroup
+      data-testid="platform-sign-in-section"
+      description="Connect this desktop to the configured identity service."
+      title="platform sign-in"
+    >
+      <SettingsOptionRow className="items-start">
+        <div className="min-w-0 flex-1 space-y-2">
+          <p className="text-sm text-muted-foreground">
+            If platform is using the wrong Google account, sign out here, then sign
+            in again and open the short-lived link in the Google account you
+            want to use. Signing out revokes agent grants owned by that account;
+            it does not remove your Buzz key or local Buzz data.
+          </p>
+          {status ? (
+            <p
+              aria-live="polite"
+              className="text-sm text-muted-foreground"
+              data-testid="platform-sign-in-status"
+            >
+              {status}
+            </p>
+          ) : null}
+          {handoffUrl ? (
+            <div className="space-y-2" data-testid="platform-handoff-link">
+              <label
+                className="text-xs font-medium text-muted-foreground"
+                htmlFor="platform-handoff-url"
+              >
+                Open this temporary sign-in link in the approved browser profile
+              </label>
+              <div className="flex min-w-0 gap-2">
+                <Input
+                  className="min-w-0 flex-1 font-mono text-xs"
+                  id="platform-handoff-url"
+                  readOnly
+                  value={handoffUrl}
+                />
+                <Button
+                  aria-label="Copy platform sign-in link"
+                  onClick={async () => {
+                    try {
+                      await writeTextToClipboard(handoffUrl);
+                      toast.success("platform sign-in link copied");
+                    } catch (error) {
+                      toast.error(
+                        error instanceof Error
+                          ? error.message
+                          : "Could not copy platform sign-in link",
+                      );
+                    }
+                  }}
+                  size="sm"
+                  type="button"
+                  variant="secondary"
+                >
+                  <Copy aria-hidden="true" className="h-4 w-4" />
+                  Copy
+                </Button>
+              </div>
+            </div>
+          ) : null}
+        </div>
+        <div className="flex shrink-0 flex-wrap gap-2">
+          <Button disabled={busy} onClick={() => void signIn()} type="button">
+            {busy ? (
+              <Spinner
+                aria-label="platform sign-in pending"
+                className="h-4 w-4 border-2"
+              />
+            ) : null}
+            Check or sign in
+          </Button>
+          <Button
+            disabled={busy}
+            onClick={() => void signOut()}
+            type="button"
+            variant="outline"
+          >
+            Sign out and revoke grants
+          </Button>
+        </div>
+      </SettingsOptionRow>
+    </SettingsOptionGroup>
+  );
+}
