+        relay_ws_url_from_http(&format!("{base}/events?x=1")),
+        Some(crate::nip_fa::PLATFORM_RELAY.to_owned())
+    );
+    let mut alternate_port = url::Url::parse(base).unwrap();
+    alternate_port.set_port(Some(8443)).unwrap();
+    assert_ne!(
+        relay_ws_url_from_http(&format!("{alternate_port}/events")),
+        Some(crate::nip_fa::PLATFORM_RELAY.to_owned())
+    );
+    let mut with_user = url::Url::parse(base).unwrap();
+    with_user.set_username("user").unwrap();
+    assert_eq!(
+        relay_ws_url_from_http(&format!("{with_user}/events")),
+        None
+    );
+}
