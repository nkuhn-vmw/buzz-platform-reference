+        let header = URL_SAFE_NO_PAD.encode(r#"{"typ":"nip-fi+jwt"}"#);
+        let claims = URL_SAFE_NO_PAD.encode(r#"{"iat":1790000000,"exp":1790000300}"#);
+        let token = format!("{header}.{claims}.signature");
+        assert!(valid_assertion(&token, 1790000300));
+        assert!(!valid_assertion(&token, 1790000301));
+        let wrong = format!(
+            "{}.{}.sig",
+            URL_SAFE_NO_PAD.encode(r#"{"typ":"JWT"}"#),
