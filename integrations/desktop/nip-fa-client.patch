+        );
+        assert!(!valid_assertion(&wrong, 1790000300));
+    }
+
+    #[tokio::test]
+    async fn timed_out_keyring_read_keeps_single_flight_gate_until_io_finishes() {
+        use std::sync::atomic::{AtomicBool, Ordering};
+
+        let lock = Arc::new(tokio::sync::Mutex::new(()));
+        let first_finished = Arc::new(AtomicBool::new(false));
+        let first_done = first_finished.clone();
+        let result = run_session_store_io(lock.clone(), Duration::from_millis(10), move || {
+            std::thread::sleep(Duration::from_millis(80));
+            first_done.store(true, Ordering::SeqCst);
+            Ok(())
+        })
+        .await;
+        assert!(result.unwrap_err().contains("did not respond"));
+
+        let duplicate_started = Arc::new(AtomicBool::new(false));
+        let duplicate = duplicate_started.clone();
+        let result = run_session_store_io(lock.clone(), Duration::from_millis(10), move || {
+            duplicate.store(true, Ordering::SeqCst);
+            Ok(())
+        })
+        .await;
+        assert!(result.unwrap_err().contains("did not respond"));
+        assert!(!duplicate_started.load(Ordering::SeqCst));
+
+        tokio::time::sleep(Duration::from_millis(90)).await;
+        assert!(first_finished.load(Ordering::SeqCst));
+
+        let retry_started = Arc::new(AtomicBool::new(false));
+        let retry = retry_started.clone();
+        run_session_store_io(lock, Duration::from_millis(100), move || {
+            retry.store(true, Ordering::SeqCst);
+            Ok(())
+        })
+        .await
+        .unwrap();
+        assert!(retry_started.load(Ordering::SeqCst));
+    }
+
+    #[tokio::test]
+    async fn loopback_callback_requires_the_bound_random_state() {
+        use axum::response::IntoResponse;
+
+        let (sender, mut receiver) = oneshot::channel();
+        let state = std::sync::Arc::new(tokio::sync::Mutex::new(CallbackState {
+            expected_state: "expected".to_owned(),
+            sender: Some(sender),
+        }));
+        let rejected = callback(
+            Query(CallbackQuery {
+                code: Some("code".to_owned()),
+                error: None,
+                state: Some("wrong".to_owned()),
+            }),
+            AxumState(state.clone()),
+        )
+        .await
+        .into_response();
+        assert_eq!(rejected.status(), StatusCode::BAD_REQUEST);
+        assert!(state.lock().await.sender.is_some());
+
+        let accepted = callback(
+            Query(CallbackQuery {
+                code: Some("one-time-code".to_owned()),
+                error: None,
+                state: Some("expected".to_owned()),
+            }),
+            AxumState(state),
+        )
+        .await
+        .into_response();
+        assert_eq!(accepted.status(), StatusCode::OK);
+        assert_eq!(receiver.try_recv().unwrap().unwrap(), "one-time-code");
+    }
+}
